{$DOMAIN_NAME:localhost} {
    reverse_proxy app:3000

    encode gzip zstd

    # Explicitly enable automatic HTTPS via Let's Encrypt / ZeroSSL
    # If DOMAIN_NAME is set, it provisions a public cert.
    tls {
        on_demand
    }

    # WebSocket support
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets app:3000
}
